{
  "name": "lapis",
  "version": "3.11.0",
  "description": "Personal Markdown Knowledge Workbench",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:mcp": "tsc -p mcp/tsconfig.json",
    "check:cli": "tsc -p cli/tsconfig.json",
    "check:arch": "node scripts/arch-gate.mjs",
    "bundle:check": "node scripts/bundle-check.mjs",
    "check:watch": "npm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "npm run i18n && vitest run",
    "test:watch": "vitest",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --silent"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@inlang/paraglide-js": "^2.24.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.17.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.15.0",
    "minisearch": "^7.2.0",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/d3-force": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "happy-dom": "^20.11.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
